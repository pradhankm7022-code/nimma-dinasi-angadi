{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["ES2017", "WebWorker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/sw.ts"]
}
